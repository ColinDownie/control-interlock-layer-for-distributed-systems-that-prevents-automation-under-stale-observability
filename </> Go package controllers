package controllers

import (
	"context"
	"encoding/json"
	"net/http"
	"time"

	appsv1 "k8s.io/api/apps/v1"

	apierrors "k8s.io/apimachinery/pkg/api/errors"
	"k8s.io/apimachinery/pkg/types"

	ctrl "sigs.k8s.io/controller-runtime"
	"sigs.k8s.io/controller-runtime/pkg/client"
	"sigs.k8s.io/controller-runtime/pkg/log"

	syncv1 "sync-controller/api/v1alpha1"
)

type SyncMonitorReconciler struct {
	client.Client
}

type SRMSignal struct {
	Omega  float64 `json:"omega"`
	TauObs float64 `json:"tau_obs"`
	TauAct float64 `json:"tau_act"`
	G      float64 `json:"g"`
}

func (r *SyncMonitorReconciler) fetchSRM(endpoint string) (*SRMSignal, error) {
	resp, err := http.Get(endpoint)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()

	var signal SRMSignal

	err = json.NewDecoder(resp.Body).Decode(&signal)
	if err != nil {
		return nil, err
	}

	return &signal, nil
}

func (r *SyncMonitorReconciler) Reconcile(
	ctx context.Context,
	req ctrl.Request,
) (ctrl.Result, error) {

	logger := log.FromContext(ctx)

	var sm syncv1.SyncMonitor

	err := r.Get(ctx, req.NamespacedName, &sm)
	if err != nil {
		if apierrors.IsNotFound(err) {
			return ctrl.Result{}, nil
		}
		return ctrl.Result{}, err
	}

	// Fetch SRM signal
	signal, err := r.fetchSRM(sm.Spec.SRMEndpoint)
	if err != nil {
		logger.Error(err, "failed to fetch SRM signal")

		return ctrl.Result{
			RequeueAfter: 5 * time.Second,
		}, nil
	}

	// Fetch target deployment
	var deployment appsv1.Deployment

	err = r.Get(
		ctx,
		types.NamespacedName{
			Name:      sm.Spec.TargetDeployment,
			Namespace: sm.Namespace,
		},
		&deployment,
	)

	if err != nil {
		return ctrl.Result{}, err
	}

	// BLIND ZONE
	if signal.G >= 1.0 {

		if !deployment.Spec.Paused {

			deployment.Spec.Paused = true

			err := r.Update(ctx, &deployment)
			if err != nil {
				return ctrl.Result{}, err
			}

			logger.Info(
				"Deployment paused due to BLIND_ZONE",
				"deployment",
				deployment.Name,
				"G",
				signal.G,
			)
		}

	} else {

		// synchronized again
		if deployment.Spec.Paused {

			deployment.Spec.Paused = false

			err := r.Update(ctx, &deployment)
			if err != nil {
				return ctrl.Result{}, err
			}

			logger.Info(
				"Deployment resumed",
				"deployment",
				deployment.Name,
				"G",
				signal.G,
			)
		}
	}

	return ctrl.Result{
		RequeueAfter: 5 * time.Second,
	}, nil
}

func (r *SyncMonitorReconciler) SetupWithManager(mgr ctrl.Manager) error {

	return ctrl.NewControllerManagedBy(mgr).
		For(&syncv1.SyncMonitor{}).
		Complete(r)
}
